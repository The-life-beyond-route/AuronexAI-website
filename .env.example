# Copy to .env locally. Add the same values in Vercel > Settings > Environment Variables.
# Prisma ORM is the database client; you still need hosted PostgreSQL (e.g. Prisma Postgres).
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"
# Vercel Prisma integration supplies DATABASE_URL_POOLED for runtime use.
# DATABASE_URL_POOLED="postgresql://USER:PASSWORD@POOLED_HOST:5432/DATABASE?sslmode=require"
RESEND_API_KEY="re_replace_me"
# Must use a domain you have verified in Resend.
# Either RESEND_FROM or the Marketplace-provided RESEND_EMAIL_DOMAIN is needed.
RESEND_FROM="AuronexAI <enquiries@your-verified-domain.com>"
# RESEND_EMAIL_DOMAIN="your-verified-domain.com"
ENQUIRY_TO="your-inbox@example.com"
SITE_URL="http://localhost:3000"
# Generate separate random values (at least 32 characters), e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET="replace-with-a-random-secret-at-least-32-characters"
CRON_SECRET="replace-with-another-random-secret-at-least-32-characters"
