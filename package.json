{
  "name": "auronexai-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "prisma generate && esbuild generated/prisma/client.ts --bundle --platform=node --format=esm --packages=external --outfile=generated/prisma-client.mjs",
    "db:studio": "prisma studio",
    "check": "node --check server.mjs && node --check assets/site.js && node --check api/enquiries.js",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "resend": "6.37.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "prisma": "7.10.1"
  }
}
